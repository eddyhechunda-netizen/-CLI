# 留空时只允许当前 lark-cli 已授权用户使用；设为 * 时允许所有可见范围内的用户。
LARK_TEST_BOT_ALLOWED_OPEN_IDS=
# 管理员 open_id，逗号分隔；留空时使用当前 lark-cli 已授权用户。
LARK_TEST_BOT_ADMIN_OPEN_IDS=

# 单个任务最大处理时间，单位秒。
LARK_TEST_BOT_JOB_TIMEOUT=1800

# 飞书单条回复最大字符数。
LARK_TEST_BOT_MAX_REPLY_CHARS=12000

# 默认使用 GPT-5.5。
LARK_TEST_BOT_COPILOT_MODEL=gpt-5.5
LARK_TEST_BOT_COPILOT_EFFORT=low
# lark-req-to-testcases Skill 目录；默认使用当前项目根目录。
LARK_TEST_BOT_SKILL_DIR=/root/req-to-testcases
# 所有 AI 任务统一由 Copilot CLI 自主 Agent 执行。
# 允许 Agent 自动连续完成多阶段产物，避免生成到一半提前结束。
LARK_TEST_BOT_MAX_AUTOPILOT_CONTINUES=8
# 日志结论未通过证据门禁时，最多自动反馈缺口并重写的次数。
LARK_TEST_BOT_LOG_ANALYSIS_MAX_REVISIONS=2

# 最长每隔多少秒探测一次任务阶段；实时状态卡默认每15秒刷新。
LARK_TEST_BOT_PROGRESS_INTERVAL=15
LARK_TEST_BOT_STATUS_REFRESH_INTERVAL=15

# 后台并行任务数。默认1可避免多个大模型任务争抢资源。
LARK_TEST_BOT_WORKERS=1
# 聊天使用独立队列，避免被耗时的用例/报告任务阻塞。
LARK_TEST_BOT_CHAT_WORKERS=1

# 长连接漏消息时的轮询兜底间隔与回看窗口。
LARK_TEST_BOT_POLL_INTERVAL=15
LARK_TEST_BOT_POLL_LOOKBACK_MINUTES=60

# 周报输入正文最大字符数。
LARK_TEST_BOT_WEEKLY_MAX_SOURCE_CHARS=40000

# 测试问答携带的最近对话轮数。
LARK_TEST_BOT_CHAT_HISTORY_TURNS=6
LARK_TEST_BOT_CHAT_HISTORY_CHARS=12000
# 单次聊天最长等待时间，单位秒。
LARK_TEST_BOT_CHAT_TIMEOUT=180

# 访问与费用保护。
LARK_TEST_BOT_CHAT_RATE_LIMIT_PER_MINUTE=10
LARK_TEST_BOT_TASK_RATE_LIMIT_PER_MINUTE=3
LARK_TEST_BOT_CHAT_DAILY_LIMIT=100
LARK_TEST_BOT_TASK_DAILY_LIMIT=20
LARK_TEST_BOT_TASK_MAX_ACTIVE_PER_USER=2
LARK_TEST_BOT_CHAT_MAX_ACTIVE_PER_USER=1
LARK_TEST_BOT_MAX_GLOBAL_QUEUED=100

# 本地消息、任务和产物保留天数；小于等于0表示不自动清理。
LARK_TEST_BOT_DATA_RETENTION_DAYS=30
LARK_TEST_BOT_CLEANUP_INTERVAL=21600

LARK_TEST_BOT_LOG_LEVEL=INFO
